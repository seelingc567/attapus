rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All reads/writes go through Cloud Functions (admin SDK), which
    // bypasses these rules entirely. Direct client access is blocked,
    // so this never expires like the default test-mode rules do.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
