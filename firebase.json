{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/classify",
        "function": "classifyFragment"
      },
      {
        "source": "/api/seed",
        "function": "seedDemoData"
      },
      {
        "source": "/api/state",
        "function": "getState"
      },
      {
        "source": "/api/resolve",
        "function": "resolveFragment"
      },
      {
        "source": "/api/complete",
        "function": "completeItem"
      },
      {
        "source": "/api/ask",
        "function": "askAttapus"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
